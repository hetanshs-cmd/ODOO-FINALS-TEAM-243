# Environment Variables — Root
#
# This is the root-level .env.example.
# The actual .env files live in backend/ and frontend/ subdirectories.
# Copy and rename backend/.env.example → backend/.env
# Copy and rename frontend/.env.example → frontend/.env
#
# Root-level variables (if using a root-level runner):

# Database (for docker-compose reference)
POSTGRES_USER=odoo_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
POSTGRES_DB=odoo_hackathon
POSTGRES_PORT=5432

# Test database (docker-compose "postgres_test" service)
POSTGRES_TEST_DB=odoo_hackathon_test
POSTGRES_TEST_PORT=5433
