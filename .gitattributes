# Normalize line endings for cross-platform compatibility
# Ensures LF in repo, CRLF on Windows checkout

* text=auto eol=lf

# Force LF for specific file types
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sql   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.env   text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
