# Environment Variables — Backend
#
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.
# Keep .env.example in version control (with placeholder values only).

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://odoo_user:odoo_password@localhost:5432/odoo_hackathon

# ── Authentication ────────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Token expiry times (use ms or zeit/ms format)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Security ──────────────────────────────────────────────────────────────────
# bcrypt work factor (12 recommended for production, 10 for development speed)
BCRYPT_ROUNDS=12

# Returns the portal magic-link token directly in the API response instead of
# (eventually) emailing it — lets the login flow be exercised locally/in CI
# without a real inbox. Leave this unset/false anywhere internet-facing: it
# is a session-issuing credential. The app refuses to boot if this is true
# at the same time as NODE_ENV=production.
ALLOW_DEV_MAGIC_LINK=true

# ── Testing ───────────────────────────────────────────────────────────────────
# Fixture password used by auth tests to hash/compare against — arbitrary,
# not a real credential, but kept out of source per docs/security.md ("no
# hardcoded secrets"). Any value is fine; tests just need it to be set.
TEST_USER_PASSWORD=REPLACE_WITH_ANY_TEST_FIXTURE_PASSWORD

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must match exactly the frontend origin (no trailing slash)
FRONTEND_URL=http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Leave RATE_LIMIT_ENABLED unset to enforce limits in production only (off in
# development/test). Set to true/false to force it. The maxes are per IP per
# window; tune without touching code.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=2000
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_AUTH_MAX=10

# ── AI / Ollama ───────────────────────────────────────────────────────────────
# Local model runtime backing /api/v1/ai/*. Install from https://ollama.com,
# then `ollama pull qwen2.5:3b-instruct` and leave `ollama serve` running.
# If unreachable or disabled, the frontend gracefully falls back to its
# deterministic template adapter — nothing else in the app depends on this.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# 20s: a 3B model on CPU with a grounded JSON-mode prompt regularly takes
# 6-8s; 8000 was cutting real, in-flight responses off as false 503s.
OLLAMA_TIMEOUT_MS=20000
