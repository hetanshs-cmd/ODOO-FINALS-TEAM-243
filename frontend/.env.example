# Environment Variables — Frontend
#
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# ── API ───────────────────────────────────────────────────────────────────────
# In development, Vite proxy handles /api → backend (see vite.config.ts)
# In production, set this to the full backend URL
VITE_API_URL=/api/v1

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_TITLE=Odoo Hackathon
